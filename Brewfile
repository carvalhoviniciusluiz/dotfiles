# Homebrew mínimo: o resto vem do asdf, npm, uv ou binários oficiais.
# No macOS 14 o brew compila do código-fonte (Tier 3); em versões mais novas usa bottles.
brew "asdf"
brew "git"   # Git atual (o do Xcode é antigo)
brew "xz"    # necessário para o módulo lzma do Python (asdf)
brew "zstd"  # necessário para compression.zstd do Python (asdf)
